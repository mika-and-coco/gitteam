#!/bin/sh
# Generated by gitteam - validates the commit message (Conventional Commits).
# Enable with: git config core.hooksPath .githooks
MSG_FILE="$$1"

if command -v gitteam >/dev/null 2>&1; then
  exec gitteam ops commit check --message-file "$$MSG_FILE"
fi

# Fallback when gitteam is not installed: minimal POSIX sh implementation.
TYPES='$commit_types_alternation'
MAX=$commit_subject_max
subject=$$(grep -v '^#' "$$MSG_FILE" | awk 'NF { print; exit }')

case "$$subject" in
  "Merge "*|"Revert \""*) exit 0 ;;
  "fixup! "*|"squash! "*|"amend! "*)
    echo "gitteam: fixup!/squash! commits must be squashed before push" >&2; exit 1 ;;
esac

if ! printf '%s\n' "$$subject" | grep -Eq "^($$TYPES)(\([^()[:space:]]+\))?!?: .+"; then
  echo "gitteam: invalid commit message: '$$subject'" >&2
  echo "  expected: <type>(<scope>)?: <description>" >&2
  echo "  types:    $$TYPES" >&2
  exit 1
fi
if [ $${#subject} -gt "$$MAX" ]; then
  echo "gitteam: commit subject is longer than $$MAX characters" >&2
  exit 1
fi
exit 0
