#!/bin/sh
# Generated by gitteam - validates branch names and commit messages before pushing.
# Enable with: git config core.hooksPath .githooks
remote="$$1"
zero=0000000000000000000000000000000000000000
PATTERN='$branch_pattern'
PROTECTED=' $protected_branches '
TYPES='$commit_types_alternation'
MAX=$commit_subject_max
status=0

has_gitteam=0
if command -v gitteam >/dev/null 2>&1; then has_gitteam=1; fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$$local_sha" = "$$zero" ] && continue            # branch deletion
  branch=$${local_ref#refs/heads/}
  [ "$$branch" = "$$local_ref" ] && continue          # not a branch (tag etc.)

  case "$$PROTECTED" in
    *" $$branch "*) ;;
    *)
      if [ "$$has_gitteam" -eq 1 ]; then
        gitteam ops branch check "$$branch" || status=1
      elif ! printf '%s\n' "$$branch" | grep -Eq "$$PATTERN"; then
        echo "gitteam: branch '$$branch' does not match $$PATTERN" >&2; status=1
      fi ;;
  esac

  if [ "$$remote_sha" = "$$zero" ]; then
    range="$$local_sha --not --remotes=$$remote"
  else
    range="$$remote_sha..$$local_sha"
  fi

  if [ "$$has_gitteam" -eq 1 ]; then
    gitteam ops commit check --range "$$range" || status=1
    continue
  fi
  git log --no-merges --format=%s $$range | while IFS= read -r subject; do
    case "$$subject" in
      ""|"Merge "*|"Revert \""*) continue ;;
    esac
    if ! printf '%s\n' "$$subject" | grep -Eq "^($$TYPES)(\([^()[:space:]]+\))?!?: .+"; then
      echo "gitteam: invalid commit subject: $$subject" >&2; exit 1
    fi
    if [ $${#subject} -gt "$$MAX" ]; then
      echo "gitteam: commit subject longer than $$MAX chars: $$subject" >&2; exit 1
    fi
  done || status=1
done

exit $$status
